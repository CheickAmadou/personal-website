---
import { NAV, SITE } from '../consts';
const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);
---

<header class="border-b border-zinc-200 dark:border-zinc-800">
  <nav class="mx-auto flex max-w-3xl items-center justify-between px-4 py-4 sm:px-6">
    <a href="/" class="font-semibold tracking-tight">{SITE.name}</a>
    <ul class="flex gap-4 text-sm sm:gap-6">
      {NAV.map(({ href, label }) => (
        <li>
          <a
            href={href}
            aria-current={isActive(href) ? 'page' : undefined}
            class:list={[
              'transition-colors hover:text-zinc-900 dark:hover:text-zinc-100',
              isActive(href)
                ? 'text-zinc-900 dark:text-zinc-100'
                : 'text-zinc-500 dark:text-zinc-400',
            ]}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
