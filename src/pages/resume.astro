---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
---

<BaseLayout title="Resume" description={`Resume of ${SITE.name}.`}>
  <div class="flex items-baseline justify-between">
    <h1 class="text-3xl font-bold tracking-tight">Resume</h1>
    <a href="/resume.pdf" class="text-sm underline" download>Download PDF</a>
  </div>

  <section class="mt-10">
    <h2 class="text-xl font-semibold">Education</h2>
    <div class="mt-4">
      <div class="flex justify-between gap-4">
        <p class="font-medium">Your University — B.S. in Your Major</p>
        <p class="shrink-0 text-sm text-zinc-500">2024 – 2028</p>
      </div>
      <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">Relevant coursework, honors, clubs.</p>
    </div>
  </section>

  <section class="mt-10">
    <h2 class="text-xl font-semibold">Experience</h2>
    <div class="mt-4">
      <div class="flex justify-between gap-4">
        <p class="font-medium">Role — Company</p>
        <p class="shrink-0 text-sm text-zinc-500">Summer 2025</p>
      </div>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-zinc-600 dark:text-zinc-400">
        <li>What you did, with a number if you have one.</li>
        <li>Another concrete outcome.</li>
      </ul>
    </div>
  </section>

  <section class="mt-10">
    <h2 class="text-xl font-semibold">Skills</h2>
    <p class="mt-3 text-sm text-zinc-600 dark:text-zinc-400">
      <strong>Languages:</strong> Python, TypeScript, Java ·
      <strong>Tools:</strong> Git, Linux, Docker
    </p>
  </section>
</BaseLayout>
