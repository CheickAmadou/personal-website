---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Blog" description="Notes on what I'm learning and building.">
  <h1 class="text-3xl font-bold tracking-tight">Blog</h1>
  <p class="mt-3 text-zinc-600 dark:text-zinc-400">Notes on what I'm learning and building.</p>
  {posts.length > 0 ? (
    <div class="mt-8 space-y-10">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  ) : (
    <p class="mt-8 text-zinc-500 dark:text-zinc-400">No posts yet — check back soon.</p>
  )}
</BaseLayout>
